{
  "name": "@xtr-dev/payload-mailing",
  "version": "0.8.0",
  "description": "Template-based email system with scheduling and job processing for PayloadCMS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tasks": {
      "import": "./dist/tasks/index.js",
      "types": "./dist/tasks/index.d.ts",
      "default": "./dist/tasks/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:tsc",
    "build:tsc": "tsc --project ./tsconfig.build.json",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "npm run dev:payload generate:importmap",
    "dev:generate-types": "npm run dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "payloadcms",
    "email",
    "templates",
    "scheduling",
    "jobs",
    "mailing",
    "richtext"
  ],
  "author": "XTR Development",
  "license": "MIT",
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "^3.37.0",
    "@payloadcms/ui": "^3.37.0",
    "payload": "^3.37.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "liquidjs": "^10.30.1",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@payloadcms/db-mongodb": "3.94.2",
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/db-sqlite": "3.94.2",
    "@payloadcms/eslint-config": "^3.28.0",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@playwright/test": "^1.65.1",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.6.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "graphql": "^16.15.0",
    "next": "^16.4.6",
    "open": "^10.2.0",
    "payload": "3.94.2",
    "prettier": "^3.10.1",
    "qs-esm": "^7.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^3.0.2",
    "sharp": "^0.35.5",
    "sort-package-json": "^2.15.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xtr-dev/payload-mailing.git"
  },
  "bugs": {
    "url": "https://github.com/xtr-dev/payload-mailing/issues"
  },
  "homepage": "https://github.com/xtr-dev/payload-mailing#readme",
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
